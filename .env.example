# ==============================================================================
# CodeTwin Configuration Environment Template
# ==============================================================================

# Backend Settings
PROJECT_NAME="CodeTwin — AI Software Repository Intelligence & Verification Platform"
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# Database
# Local SQLite fallback:
DATABASE_URL=sqlite+aiosqlite:///./codetwin.db
# PostgreSQL + pgvector (for Docker or Cloud):
# DATABASE_URL=postgresql+asyncpg://codetwin:codetwin_secret@localhost:5432/codetwin_db

# Storage Directories
STORAGE_DIR=./backend/storage
REPOS_DIR=./backend/storage/repos
UPLOADS_DIR=./backend/storage/uploads

# Security & Sandboxing
DOCKER_SANDBOX_ENABLED=false
EXECUTION_TIMEOUT_SECONDS=120

# AI Models & Providers (Ollama, OpenAI, Local)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OLLAMA_API_BASE=http://localhost:11434
DEFAULT_LLM_PROVIDER=mock

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
